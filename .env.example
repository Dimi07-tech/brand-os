# Copier en .env à la racine et adapter. Ne jamais committer le .env.

NODE_ENV=development

# --- Base de données (PostgreSQL) ---
DATABASE_URL=postgresql://brandos:brandos@localhost:5432/brandos

# --- Redis (cache + file de tâches BullMQ) ---
REDIS_URL=redis://localhost:6379

# --- API ---
API_PORT=4000
WEB_ORIGIN=http://localhost:3000

# --- Web ---
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# --- Stockage objet compatible S3 (production, ou MinIO via docker compose) ---
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=brand-os
S3_ACCESS_KEY=brandos
S3_SECRET_KEY=brandos-secret

# --- E-mails (Resend/Brevo en prod) ---
# Vide : les e-mails sont affichés dans les logs de l'API.
# Avec Mailpit (docker compose) : smtp://localhost:1025, interface sur http://localhost:8025
SMTP_URL=
MAIL_FROM="Brand OS <no-reply@brandos.local>"

# --- IA (choix du fournisseur à décider, §12.6) ---
AI_PROVIDER=
AI_API_KEY=
AI_DAILY_BUDGET_XOF=20000

# --- Paiements (FedaPay ou KkiaPay, à décider, §6.3) ---
PAYMENT_PROVIDER=fedapay
PAYMENT_SECRET_KEY=
PAYMENT_WEBHOOK_SECRET=

# --- Fichiers et exports (§7.1, §9.1) ---
# local : fichiers dans .dev/storage, liens signés par l'API ; s3 : stockage objet (S3_*)
STORAGE_DRIVER=local
# Secret de signature des liens de téléchargement (32 caractères aléatoires minimum)
FILE_SIGNING_SECRET=a-remplacer-par-32-caracteres-aleatoires-minimum
# true : l'API traite aussi les exports ; en production, worker séparé (node dist/worker.js)
WORKERS_ENABLED=true
# Chromium pour les PDF (détecté automatiquement si vide)
CHROMIUM_PATH=
# Ghostscript : conversion CMJN des PDF pour l'imprimeur (cartes de visite)
GHOSTSCRIPT_PATH=gs
