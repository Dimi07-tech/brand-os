    "migrate:deploy": "prisma migrate deploy",
    "studio": "prisma studio",
    "validate": "prisma validate",
    "test": "vitest run"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "dotenv": "^17.0.0",
    "prisma": "7.10.1",
    "typescript": "^5.9.0",
    "vitest": "^4.1.2"
  }
