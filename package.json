{
  "name": "brand-os",
  "private": true,
  "packageManager": "npm@12.0.2",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "services:start": "scripts/dev-services.sh start",
    "services:stop": "scripts/dev-services.sh stop",
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:generate": "npm run generate -w @brand-os/db",
    "db:migrate": "npm run migrate:dev -w @brand-os/db",
    "db:studio": "npm run studio -w @brand-os/db"
  },
  "devDependencies": {
    "turbo": "^2.5.0",
    "typescript": "^5.9.0"
  },
  "allowScripts": {
    "prisma@7.10.1": true,
    "@prisma/engines@7.10.1": true,
    "unrs-resolver@1.12.2": true,
    "@scarf/scarf": false,
    "msgpackr-extract": false
  }
}
